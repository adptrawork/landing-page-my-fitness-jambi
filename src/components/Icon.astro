---
// Ikon SVG inline (stroke konsisten 1.5, currentColor). Tanpa emoji, tanpa dependency.
interface Props { name: string; class?: string; }
const { name, class: cls = 'h-6 w-6' } = Astro.props;

const paths: Record<string, string> = {
  pin: '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2" stroke-linecap="round" stroke-linejoin="round"/>',
  gym: '<path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10" stroke-linecap="round" stroke-linejoin="round"/>',
  users: '<circle cx="9" cy="9" r="3"/><path d="M4 19c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke-linecap="round"/><path d="M16 7.5a2.6 2.6 0 0 1 0 5M17.5 19c0-1.9-.6-3.4-1.6-4.5" stroke-linecap="round"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none"/>',
  clipboard: '<rect x="6" y="4.5" width="12" height="16" rx="2"/><path d="M9.5 4.5h5v2h-5z" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 13.5l2 2 4-4.5" stroke-linecap="round" stroke-linejoin="round"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round"/>',
};
const svg = paths[name] ?? paths.check;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={cls} aria-hidden="true" set:html={svg} />
