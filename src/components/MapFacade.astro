---
interface Props { src: string; title: string; mapsUrl: string; label?: string }
const { src, title, mapsUrl, label = 'Muat peta & buka rute' } = Astro.props;
---
<!-- MapFacade: iframe Google Maps baru disuntik setelah klik (hemat ~7 MB JS peta saat load awal). -->
<div
  class="map-facade relative aspect-[16/11] overflow-hidden rounded-2xl border border-paper/15 bg-ink-2 md:aspect-video"
  data-src={src}
  data-title={title}
>
  <div class="pointer-events-none absolute inset-0 grid place-items-center" aria-hidden="true">
    <div class="text-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto h-10 w-10 text-accent" aria-hidden="true">
        <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="12" cy="10" r="2.6" />
      </svg>
      <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-haze">Peta area The Hok</p>
    </div>
  </div>
  <a href={mapsUrl} class="absolute inset-0 grid place-items-center" data-map-link>
    <span class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
      {label}
    </span>
  </a>
</div>
<script is:inline>
  (function () {
    function init(scope) {
      (scope || document).querySelectorAll('.map-facade').forEach(function (el) {
        if (el.dataset.done) return; el.dataset.done = '1';
        el.querySelector('[data-map-link]').addEventListener('click', function (ev) {
          ev.preventDefault();
          var f = document.createElement('iframe');
          f.title = el.dataset.title || 'Peta lokasi';
          f.src = el.dataset.src; f.loading = 'lazy';
          f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
          el.appendChild(f); el.querySelector('[data-map-link]').remove();
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); });
    else init(document);
  })();
</script>
