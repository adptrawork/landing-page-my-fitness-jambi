---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title={`Kontak ${business.name} — Lokasi The Hok & Rute`} description={`Kunjungi My Fitness Jambi di The Hok. WA/IG resmi belum terverifikasi — info pasti via kunjungan langsung / Google Maps.`} canonicalPath="/kontak">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="text-sm font-medium text-sky-700">Kontak</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Datang & survei langsung</h1>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">WA/IG resmi <strong>belum terverifikasi</strong> — tidak ada tombol chat agar tidak salah sambung. Salin daftar tanya di bawah, bawa saat survei.</p>
        <div class="mt-8 bg-white border border-slate-200/50 rounded-[2.5rem] p-8">
          <p class="font-semibold">Daftar tanya saat survei</p>
          <ul class="mt-3 space-y-2 text-base text-gray-600 list-disc pl-5">
            <li>Harga harian / bulanan / tahunan saat ini?</li>
            <li>Jam operasional & jam ramai?</li>
            <li>Jadwal kelas grup minggu ini?</li>
            <li>Ada coach / personal training?</li>
            <li>Fasilitas: kamar mandi, loker, parkir?</li>
          </ul>
          <button id="copy" class="mt-5 bg-sky-700 text-white px-7 py-3.5 rounded-full font-medium active:scale-[0.98]">Salin Daftar Tanya</button>
          <p id="ok" class="hidden mt-2 text-sm text-sky-700">Tersalin — bawa saat survei.</p>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src="/images/my-fitness-1.jpg" alt="Area beban gym My Fitness The Hok Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-8">
            <p class="font-semibold">Info kunjungan</p>
            <p class="mt-2 text-sm text-gray-600">{business.address}</p>
            <p class="mt-1 text-sm text-gray-600">{business.hours}</p>
            <a class="mt-4 inline-block underline" href={business.mapsUrl}>Rute ke lokasi</a>
          </div>
        </div>
        <p class="mt-3 text-xs text-zinc-400">Sumber foto: Unsplash (bebas lisensi) — ganti foto asli gym.</p>
      </div>
    </div>
    <div class="mt-8 rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
      <iframe title="Peta My Fitness Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
    </div>
  </section>
<script is:inline>
document.getElementById('copy').addEventListener('click', function() {
  var msg = 'Halo My Fitness Jambi, saya mau tanya: 1) Harga harian/bulanan/tahunan? 2) Jam operasional & jam ramai? 3) Jadwal kelas? 4) Ada PT? 5) Fasilitas kamar mandi/loker/parkir?';
  navigator.clipboard.writeText(msg).then(function() {
    document.getElementById('ok').classList.remove('hidden');
  });
});
</script>
</BaseLayout>
