---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapFacade from '../components/MapFacade.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
const maps = business.mapsUrl;

const faqs = [
  { q: 'Bagaimana cara menghubungi My Fitness?', a: 'Kanal yang tersedia saat ini adalah kunjungan langsung ke lokasi dan Google Maps. Nomor WhatsApp resmi belum terverifikasi sehingga tidak kami tampilkan.' },
  { q: 'Jam berapa sebaiknya datang?', a: 'Jam operasional resmi belum dikonfirmasi. Cek titik lokasi di Google Maps, lalu pilih waktu kunjungan saat area terlihat buka.' },
  { q: 'Apakah perlu daftar sebelum datang?', a: 'Tidak. Datang langsung untuk survei dan tanyakan paket, jadwal kelas, serta ketersediaan pendamping.' },
];
---
<!-- Ref: athletic location panel — panel lokasi + MapFacade klik-untuk-muat + CTA, tanpa nomor karangan -->
<BaseLayout
  title="Kontak & Lokasi My Fitness Jambi — Alamat, Peta & Rute"
  description="Alamat, peta, dan cara menghubungi My Fitness kawasan The Hok Jambi Selatan. Datang langsung atau buka rute Google Maps sebelum berkunjung."
  canonicalPath="/kontak/"
  crumb="Kontak"
  image={business.ogImage}
>
  <section class="border-b border-paper/10" aria-labelledby="page-title">
    <div class="mx-auto max-w-7xl px-4 py-14 md:py-20">
      <nav class="text-[11px] font-semibold uppercase tracking-[0.2em] text-haze" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-accent">Beranda</a>
        <span class="px-2 text-paper/30">/</span>
        <span class="text-paper">Kontak</span>
      </nav>
      <h1 id="page-title" class="font-display mt-5 max-w-[18ch] text-4xl font-bold uppercase leading-[0.94] tracking-tight md:text-6xl">
        Kunjungi My Fitness
      </h1>
      <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-haze md:text-lg">
        Cara paling akurat untuk tahu fasilitas, jadwal, dan tarif adalah datang langsung ke kawasan The Hok,
        Jambi Selatan. Buka peta di bawah untuk melihat rute.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 md:py-20" aria-labelledby="kontak-title">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <h2 id="kontak-title" class="font-display text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">
          Kontak &amp; jam
        </h2>

        <dl class="mt-8 divide-y divide-paper/10 border-y border-paper/10">
          <div class="py-4">
            <dt class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-haze"><span class="text-accent"><Icon name="pin" class="h-5 w-5" /></span>Alamat</dt>
            <dd class="mt-1 text-base leading-relaxed">{business.address}</dd>
          </div>
          <div class="py-4">
            <dt class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-haze"><span class="text-accent"><Icon name="clock" class="h-5 w-5" /></span>Jam operasional</dt>
            <dd class="mt-1 text-base leading-relaxed">{business.hours}</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-col gap-3">
          <a href={maps} class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
            Rute ke lokasi
            <Icon name="arrow" class="h-5 w-5" />
          </a>
          <div class="rounded-2xl border border-paper/15 bg-ink-2/40 p-5">
            <p class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">
              <Icon name="users" class="h-4 w-4" />
              WhatsApp
            </p>
            <p class="mt-2 text-sm leading-relaxed text-haze">
              Nomor WhatsApp resmi belum terverifikasi, jadi belum tersedia tautan chat. Untuk pertanyaan cepat,
              silakan datang langsung ke lokasi.
            </p>
          </div>
        </div>
      </div>

      <div class="md:col-span-7">
        <MapFacade src={business.mapsEmbed} title="Peta lokasi My Fitness The Hok Jambi" mapsUrl={maps} />
        <p class="mt-3 text-sm leading-relaxed text-haze">
          Peta dimuat hanya setelah kamu mengeklik tombol, agar halaman tetap ringan. Bisa juga langsung buka
          <a href={maps} class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"> rute di Google Maps</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-paper/10 bg-ink-2/25" aria-labelledby="faq-title">
    <div class="mx-auto max-w-7xl px-4 py-14 md:py-20">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Pertanyaan umum</p>
          <h2 id="faq-title" class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight">
            Sebelum berkunjung
          </h2>
        </div>
        <div class="md:col-span-8">
          <Faq items={faqs} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
