---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title="Kontak My Fitness The Hok — Kunjungan & Rute" description="Kunjungi My Fitness area The Hok Jambi: titik pasti via Google Maps. Jam operasional dan harga dikonfirmasi langsung di lokasi." canonicalPath="/kontak">
  <section class="max-w-7xl mx-auto px-4 py-16 md:py-24 md:pr-[18vw]">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">Kontak</p>
    <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-[1.02]">Cukup datang dan lihat</h1>
    <p class="mt-6 text-lg text-stone-500 max-w-[55ch]">Tidak ada nomor resmi yang terverifikasi — cara terbaik adalah <strong>kunjungan langsung</strong>. Catat yang mau ditanyakan:</p>
    <div class="mt-10 max-w-xl bg-white border border-stone-200/70 rounded-[2.5rem] p-8 space-y-4">
      <div><label for="nama" class="text-sm">Nama</label><input id="nama" placeholder="Nama kamu" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-stone-50" /></div>
      <div><label for="tanya" class="text-sm">Mau tanya apa saat survei</label><select id="tanya" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-stone-50"><option>Harga member bulanan</option><option>Jadwal kelas</option><option>Personal trainer</option><option>Jam ramai / sepi</option></select></div>
      <button id="copy" class="bg-lime-700 text-white px-7 py-3.5 rounded-full text-sm active:scale-[0.98]">Salin Catatan Survei</button>
      <p id="ok" class="hidden text-sm text-lime-700">Tersalin — bawa catatan ini saat berkunjung.</p>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-12 gap-10">
    <div class="md:col-span-4">
      <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-stone-400">Info kunjungan</p>
      <p class="mt-4 text-base text-stone-500">{business.address}</p>
      <p class="mt-1 text-base text-stone-500">{business.hours}</p>
      <a class="mt-6 inline-block underline underline-offset-8 decoration-lime-700/40" href={business.mapsUrl}>Rute ke lokasi</a>
    </div>
    <div class="md:col-span-8">
      <div class="rounded-[2.5rem] overflow-hidden border border-stone-200/70 aspect-video bg-stone-100">
        <iframe title="Peta My Fitness Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
      </div>
    </div>
  </section>
<script is:inline>
document.getElementById('copy').addEventListener('click', function() {
  var nama = (document.getElementById('nama').value || '').trim() || '[nama]';
  var tanya = document.getElementById('tanya').value;
  navigator.clipboard.writeText('Catatan survei My Fitness (' + nama + '): ' + tanya + '.').then(function() {
    document.getElementById('ok').classList.remove('hidden');
  });
});
</script>
</BaseLayout>
