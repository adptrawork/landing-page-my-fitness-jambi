---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, prices } from '../data/business';
---
<BaseLayout title="Harga My Fitness The Hok — Estimasi Harian & Bulanan" description="Harga My Fitness The Hok: estimasi harian, mingguan, bulanan, PT, tahunan. Belum ada price list resmi — konfirmasi langsung di lokasi." canonicalPath="/harga">
  <section class="max-w-7xl mx-auto px-4 py-16 md:py-24 md:pr-[18vw]">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">Harga</p>
    <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-[1.02]">Bayar dekat, latihan dekat</h1>
    <p class="mt-6 text-lg text-stone-500 max-w-[55ch]">Semua angka <strong>Estimasi</strong> — tanya resepsionis sebelum membayar.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-10 gap-6" aria-label="Daftar harga">
    <div class="shimmer md:col-span-7 bg-lime-700 text-white rounded-[2.5rem] p-10 md:p-14">
      <p class="font-mono-num text-[11px] tracking-[0.25em] uppercase text-lime-100">{prices[3].badge}</p>
      <p class="mt-3 text-2xl md:text-3xl tracking-tight">{prices[3].name}</p>
      <p class="mt-3 font-mono-num text-4xl md:text-5xl">{prices[3].price}</p>
      <p class="mt-4 text-lime-50/80">{prices[3].desc}</p>
    </div>
    <div class="md:col-span-3 flex flex-col gap-6">
      {prices.slice(0, 3).map((p) => (
        <div class="shimmer flex-1 bg-white border border-stone-200/70 rounded-[2.5rem] p-8">
          <p class="font-mono-num text-[11px] tracking-[0.25em] uppercase text-stone-400">{p.badge}</p>
          <p class="mt-2 tracking-tight">{p.name}</p>
          <p class="mt-2 font-mono-num text-xl text-lime-700">{p.price}</p>
          <p class="mt-1 text-sm text-stone-500">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 mt-6 grid grid-cols-1 md:grid-cols-10 gap-6">
    {prices.slice(4).map((p) => (
      <div class="shimmer md:col-span-5 bg-white border border-stone-200/70 rounded-[2.5rem] p-8 flex items-baseline gap-5">
        <div class="flex-1">
          <p class="font-mono-num text-[11px] tracking-[0.25em] uppercase text-stone-400">{p.badge}</p>
          <p class="mt-1 tracking-tight text-lg">{p.name}</p>
          <p class="mt-1 text-sm text-stone-500">{p.desc}</p>
        </div>
        <p class="font-mono-num text-xl text-lime-700 whitespace-nowrap">{p.price}</p>
      </div>
    ))}
  </section>
</BaseLayout>
