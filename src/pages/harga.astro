---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business, prices } from '../data/business';
const maps = business.mapsUrl;
---
<!-- Ref: athletic price sheet — tabel ber-rule jadi kartu di mobile, tanpa label "Terpopuler" -->
<BaseLayout
  title="Estimasi Harga Keanggotaan My Fitness The Hok Jambi"
  description="Estimasi biaya harian, mingguan, bulanan, dan personal training di My Fitness Jambi. Semua angka estimasi rata-rata gym Jambi, konfirmasi tarif di lokasi."
  canonicalPath="/harga/"
  crumb="Harga"
  image={business.ogImage}
>
  <section class="border-b border-paper/15" aria-labelledby="page-title">
    <div class="mx-auto max-w-7xl px-4 py-14 md:py-20">
      <nav class="text-[11px] font-semibold uppercase tracking-[0.2em] text-haze" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-accent">Beranda</a>
        <span class="px-2 text-paper/60">/</span>
        <span class="text-paper">Harga</span>
      </nav>
      <h1 id="page-title" class="font-display mt-5 max-w-[18ch] text-4xl font-bold uppercase leading-[0.94] tracking-tight md:text-6xl">
        Estimasi biaya keanggotaan
      </h1>
      <p class="mt-5 max-w-[64ch] text-base leading-relaxed text-haze md:text-lg">
        My Fitness belum menerbitkan price list resmi. Angka di bawah adalah estimasi rata-rata gym di Jambi
        untuk membantu perencanaan &mdash; tarif berlaku hanya setelah dikonfirmasi di resepsionis.
      </p>
      <a href={maps} class="mt-8 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
        Cek tarif di lokasi
        <Icon name="arrow" class="h-5 w-5" />
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 md:py-20" aria-labelledby="tabel-title">
    <h2 id="tabel-title" class="font-display text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">
      Daftar estimasi
    </h2>

    <table class="price-table mt-8 w-full text-left">
      <caption class="sr-only">Estimasi harga paket keanggotaan My Fitness Jambi (belum terverifikasi)</caption>
      <thead class="border-b border-paper/15 text-[11px] font-semibold uppercase tracking-[0.22em] text-haze">
        <tr>
          <th scope="col" class="py-3 pr-4 font-semibold">Paket</th>
          <th scope="col" class="py-3 pr-4 font-semibold">Estimasi harga</th>
          <th scope="col" class="py-3 font-semibold">Catatan</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-paper/15">
        {prices.map((p) => (
          <tr>
            <th scope="row" class="py-5 pr-4 text-left align-top">
              <span class="font-display block text-xl font-semibold uppercase tracking-wide">{p.name}</span>
              <span class="mt-1 inline-block text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">{p.badge}</span>
            </th>
            <td class="py-5 pr-4 align-top">
              <span class="num font-display block text-2xl font-bold">{p.price}</span>
            </td>
            <td class="py-5 align-top text-sm leading-relaxed text-haze">{p.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-12">
      <ul class="flex flex-col gap-3 md:col-span-7">
        <li class="flex items-start gap-3 text-sm leading-relaxed text-haze">
          <span class="mt-0.5 text-accent"><Icon name="check" class="h-5 w-5" /></span>
          Semua harga bertanda "Estimasi" &mdash; bukan penawaran resmi dan bisa berubah sewaktu-waktu.
        </li>
        <li class="flex items-start gap-3 text-sm leading-relaxed text-haze">
          <span class="mt-0.5 text-accent"><Icon name="check" class="h-5 w-5" /></span>
          Belum ada kanal pembayaran online resmi. Lakukan transaksi hanya di lokasi.
        </li>
        <li class="flex items-start gap-3 text-sm leading-relaxed text-haze">
          <span class="mt-0.5 text-accent"><Icon name="check" class="h-5 w-5" /></span>
          Cek dulu apakah ada sesi coba sebelum membeli paket berdurasi panjang.
        </li>
      </ul>
      <div class="md:col-span-5">
        <div class="rounded-2xl border border-paper/15 bg-ink-2/40 p-6">
          <p class="font-display text-2xl font-bold uppercase leading-none tracking-tight">Belum yakin?</p>
          <p class="mt-3 text-sm leading-relaxed text-haze">
            Datang dan tanyakan paket yang paling sesuai. Tidak ada komitmen sampai kamu memutuskan.
          </p>
          <a href="/kontak/" class="mt-5 inline-flex min-h-[48px] items-center justify-center rounded-full border border-accent px-6 text-sm font-bold uppercase tracking-[0.1em] text-accent transition-colors hover:bg-accent hover:text-ink active:scale-[0.98]">
            Kontak &amp; lokasi
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
