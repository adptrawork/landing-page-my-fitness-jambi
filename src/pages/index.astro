---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapFacade from '../components/MapFacade.astro';
import Icon from '../components/Icon.astro';
import { business, programs, prices } from '../data/business';

const maps = business.mapsUrl;

// Jadwal resmi belum ada di business.ts — jangan dikarang.
const schedule = 'Konfirmasi di lokasi';

const activity = [
  { name: 'Open Gym — Beban & Kardio', who: 'Semua level', icon: 'gym' },
  { name: 'Kelas Grup', who: 'Terjadwal', icon: 'users' },
  { name: 'Personal Training', who: '1-on-1', icon: 'target' },
  { name: 'Asesmen & Konsultasi Pemula', who: 'Pemula', icon: 'clipboard' },
];
---
<!-- Ref: athletic split hero + ticker, pola gym/atletik kontras tinggi -->
<BaseLayout
  title="My Fitness Jambi — Gym Beban, Kardio & Kelas The Hok"
  description="My Fitness kawasan The Hok, Jambi Selatan: area beban dan kardio, kelas grup, personal training untuk warga sekitar. Survei lokasi dulu, tanpa komitmen."
  canonicalPath="/"
  image={business.ogImage}
>
  <!-- Ref: athletic split hero — teks kiri, foto area beban kanan; menghindari hero center -->
  <section class="border-b border-paper/15" aria-labelledby="hero-title">
    <div class="mx-auto grid min-h-[100dvh] max-w-7xl grid-cols-1 md:grid-cols-2">
      <div class="flex flex-col justify-center px-4 py-20 md:px-8 md:py-24">
        <p class="rise inline-flex w-max items-center gap-2 rounded-full border border-paper/20 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent" style="--i:0">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          The Hok &mdash; Jambi Selatan
        </p>
        <h1 id="hero-title" class="rise font-display mt-6 max-w-[15ch] text-5xl font-bold uppercase leading-[0.92] tracking-tight sm:text-6xl md:text-7xl" style="--i:1">
          Gym dekat rumah untuk warga The Hok
        </h1>
        <p class="rise mt-6 max-w-[52ch] text-base leading-relaxed text-haze md:text-lg" style="--i:2">
          Area beban dan kardio, kelas grup, serta personal training dalam satu tempat yang bisa dicapai jalan kaki.
          Survei dulu, cocok baru lanjut.
        </p>
        <div class="rise mt-9 flex flex-wrap items-center gap-3" style="--i:3">
          <a href={maps} class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
            Rute ke lokasi
            <Icon name="arrow" class="h-5 w-5" />
          </a>
          <a href="/program/" class="inline-flex min-h-[48px] items-center rounded-full border border-paper/30 px-7 text-sm font-bold uppercase tracking-[0.1em] text-paper transition-colors hover:border-accent hover:text-accent active:scale-[0.98]">
            Lihat program
          </a>
        </div>
        <dl class="rise mt-12 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 border-t border-paper/15 pt-6" style="--i:4">
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-haze">Fokus</dt>
            <dd class="mt-1 font-display text-lg font-semibold uppercase tracking-wide">Beban &amp; kelas</dd>
          </div>
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.2em] text-haze">Komitmen</dt>
            <dd class="mt-1 font-display text-lg font-semibold uppercase tracking-wide">Tanpa ikatan</dd>
          </div>
        </dl>
      </div>

      <div class="relative min-h-[52vh] md:min-h-full">
        <span class="stopwatch-overlay" aria-hidden="true">⏱</span>
        <img
          src="/images/my-fitness-1.webp"
          alt="Rak dumbel dan area latihan beban di My Fitness The Hok Jambi"
          width="800"
          height="533"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent md:bg-gradient-to-r md:from-ink md:via-ink/25 md:to-transparent" aria-hidden="true"></div>
        <p class="absolute bottom-5 left-5 right-5 font-display text-sm font-semibold uppercase tracking-[0.16em] text-paper md:left-8">
          Area beban &mdash; foto konteks, ganti dengan foto lokasi asli
        </p>
      </div>
    </div>
  </section>

  <!-- Ref: ticker fasilitas — marquee CSS transform, otomatis statis saat prefers-reduced-motion -->
  <div class="ticker border-b border-paper/15 bg-ink-2/50 py-3">
    <div class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {['Area Beban', 'Kardio', 'Kelas Grup', 'Personal Training', 'Asesmen Pemula', 'The Hok', 'Jambi Selatan', 'Survei Dulu', 'Tanpa Komitmen'].map((word) => (
            <span class="flex items-center whitespace-nowrap px-5 font-display text-xl font-semibold uppercase tracking-[0.08em] text-paper">
              {word}
              <span class="ml-5 h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Ref: bento fitur asimetris 2fr/1fr/1fr — bukan tiga kartu berukuran sama -->
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-24" aria-labelledby="fitur-title">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Yang kamu dapat</p>
        <h2 id="fitur-title" class="font-display mt-2 max-w-[22ch] text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-5xl">
          Fasilitas inti, tanpa embel-embel
        </h2>
      </div>
      <p class="max-w-[46ch] text-sm leading-relaxed text-haze md:text-right">
        Empat hal yang paling sering dipakai member. Ketersediaan alat dan kelas bisa berubah &mdash;
        konfirmasi saat berkunjung.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-4 md:grid-rows-2">
      <article class="rise col-span-1 flex flex-col justify-between rounded-2xl border border-paper/15 bg-ink-2/40 p-6 md:col-span-2 md:row-span-2 md:p-8" style="--i:0">
        <div class="text-accent"><Icon name="gym" class="h-9 w-9" /></div>
        <div class="mt-8">
          <h3 class="font-display text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">Area beban &amp; kardio</h3>
          <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-haze">
            Mesin kardio dan peralatan beban untuk latihan harian. Daftar peralatan resmi belum kami terima,
            jadi sebaiknya kamu lihat langsung saat berkunjung.
          </p>
        </div>
      </article>

      <article class="rise col-span-1 rounded-2xl border border-paper/15 bg-ink-2/40 p-6 md:col-span-2" style="--i:1">
        <div class="text-accent"><Icon name="users" class="h-8 w-8" /></div>
        <h3 class="font-display mt-4 text-2xl font-bold uppercase leading-none tracking-tight">Kelas grup</h3>
        <p class="mt-2 text-sm leading-relaxed text-haze">Latihan bersama instruktur. Jadwal resmi cek papan info lokasi.</p>
      </article>

      <article class="rise rounded-2xl border border-accent bg-accent p-6 text-ink" style="--i:2">
        <Icon name="target" class="h-8 w-8" />
        <h3 class="font-display mt-4 text-2xl font-bold uppercase leading-none tracking-tight">Personal training</h3>
        <p class="mt-2 text-sm font-medium leading-relaxed text-ink/90">Program 1-on-1 sesuai target. Tarif dan slot tanya di lokasi.</p>
      </article>

      <article class="rise rounded-2xl border border-paper/15 bg-ink-2/40 p-6" style="--i:3">
        <div class="text-accent"><Icon name="clipboard" class="h-8 w-8" /></div>
        <h3 class="font-display mt-4 text-2xl font-bold uppercase leading-none tracking-tight">Asesmen pemula</h3>
        <p class="mt-2 text-sm leading-relaxed text-haze">Mulai dari nol dengan arahan singkat sebelum latihan.</p>
      </article>
    </div>
  </section>

  <!-- Ref: daftar aktivitas berkolom — list ber-rule divide-y, tabel jadi bertumpuk di mobile -->
  <section class="border-y border-paper/15 bg-ink-2/25" aria-labelledby="aktivitas-title">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Aktivitas</p>
          <h2 id="aktivitas-title" class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-5xl">
            Pilih aktivitasmu
          </h2>
        </div>
        <p class="text-sm leading-relaxed text-haze md:col-span-4">
          Jadwal pasti tiap aktivitas belum terverifikasi, jadi kami tidak menampilkan jam yang berpotensi menyesatkan.
        </p>
      </div>

      <div class="mt-10 hidden grid-cols-12 gap-4 border-b border-paper/15 pb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-haze md:grid">
        <span class="col-span-5">Aktivitas</span>
        <span class="col-span-3">Untuk siapa</span>
        <span class="col-span-4 text-right">Jadwal</span>
      </div>
      <ul class="divide-y divide-paper/15 border-b border-paper/15">
        {activity.map((row, i) => (
          <li class="rise grid grid-cols-1 items-center gap-1 py-5 md:grid-cols-12 md:gap-4" style={`--i:${i}`}>
            <div class="flex items-center gap-3 md:col-span-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-paper/15 text-accent"><Icon name={row.icon} class="h-5 w-5" /></span>
              <span class="font-display text-xl font-semibold uppercase tracking-wide">{row.name}</span>
            </div>
            <p class="pl-[3.25rem] text-sm text-haze md:col-span-3 md:pl-0">{row.who}</p>
            <p class="pl-[3.25rem] text-sm text-haze md:col-span-4 md:pl-0 md:text-right">{schedule}</p>
          </li>
        ))}
      </ul>
      <p class="mt-4 max-w-[80ch] text-xs leading-relaxed text-haze">
        Boxing, zumba, dan yoga disebut pada sumber direktori publik, namun belum terverifikasi pada kunjungan
        terakhir &mdash; karena itu tidak kami tampilkan sebagai jadwal tetap.
      </p>
    </div>
  </section>

  <!-- Ref: blok program zig-zag dua kolom dengan gambar bergantian -->
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-24" aria-labelledby="program-title">
    <div class="max-w-[46ch]">
      <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Program</p>
      <h2 id="program-title" class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-5xl">
        Empat cara memulai
      </h2>
      <p class="mt-4 text-base leading-relaxed text-haze">
        Setiap program ditandai sesuai tingkat keyakinan datanya. Label "Estimasi" berarti perlu dikonfirmasi
        di lokasi sebelum kamu memutuskan.
      </p>
    </div>

    <div class="mt-14 flex flex-col gap-16 md:gap-24">
      {programs.map((p, i) => (
        <article class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-14">
          <div class:list={['relative overflow-hidden rounded-2xl border border-paper/15', i % 2 === 1 ? 'md:order-2' : '']}>
            <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
          </div>
          <div class:list={[i % 2 === 1 ? 'md:order-1' : '']}>
            <div class="flex items-center gap-3">
              <span class="num font-display text-4xl font-bold leading-none text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span class="rounded-full border border-paper/20 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-haze">{p.badge}</span>
            </div>
            <h3 class="font-display mt-4 text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">{p.name}</h3>
            <p class="mt-3 max-w-[50ch] text-base leading-relaxed text-haze">{p.desc}</p>
            <a href={maps} class="mt-6 inline-flex min-h-[48px] items-center gap-2 rounded-full border border-accent px-6 text-sm font-bold uppercase tracking-[0.1em] text-accent transition-colors hover:bg-accent hover:text-ink active:scale-[0.98]">
              Tanya di lokasi
              <Icon name="arrow" class="h-5 w-5" />
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-10 text-xs leading-relaxed text-haze">
      Foto pada bagian ini bersifat konteks, bukan dokumentasi resmi My Fitness Jambi.
    </p>
  </section>

  <!-- Ref: blok harga — tabel ber-rule yang berubah menjadi kartu di mobile -->
  <section class="border-y border-paper/15 bg-ink-2/25" aria-labelledby="harga-title">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Keanggotaan</p>
          <h2 id="harga-title" class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-5xl">
            Estimasi biaya
          </h2>
        </div>
        <p class="text-sm leading-relaxed text-haze md:col-span-4">
          Belum ada price list resmi. Angka berikut adalah estimasi rata-rata gym Jambi, bukan penawaran tetap.
        </p>
      </div>

      <table class="price-table mt-10 w-full text-left">
        <caption class="sr-only">Estimasi harga keanggotaan My Fitness Jambi</caption>
        <thead class="border-b border-paper/15 text-[11px] font-semibold uppercase tracking-[0.22em] text-haze">
          <tr>
            <th scope="col" class="py-3 pr-4 font-semibold">Paket</th>
            <th scope="col" class="py-3 pr-4 font-semibold">Harga</th>
            <th scope="col" class="py-3 font-semibold">Catatan</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-paper/15">
          {prices.map((p) => (
            <tr>
              <th scope="row" class="py-5 pr-4 text-left align-top">
                <span class="font-display block text-xl font-semibold uppercase tracking-wide">{p.name}</span>
                <span class="mt-1 inline-block text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">{p.badge}</span>
              </th>
              <td class="py-5 pr-4 align-top">
                <span class="num font-display block text-2xl font-bold">{p.price}</span>
              </td>
              <td class="py-5 align-top text-sm leading-relaxed text-haze">{p.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a href={maps} class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
          Cek tarif di lokasi
          <Icon name="arrow" class="h-5 w-5" />
        </a>
        <a href="/harga/" class="text-sm font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">Rincian paket &amp; catatan</a>
      </div>
    </div>
  </section>

  <!-- Ref: panel lokasi + jam operasional + MapFacade klik-untuk-muat + CTA kunjungan -->
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-24" aria-labelledby="lokasi-title">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Lokasi &amp; jam</p>
        <h2 id="lokasi-title" class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-5xl">
          Mampir dulu sebelum daftar
        </h2>
        <dl class="mt-8 divide-y divide-paper/15 border-y border-paper/15">
          <div class="py-4">
            <dt class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-haze"><span class="text-accent"><Icon name="pin" class="h-5 w-5" /></span>Alamat</dt>
            <dd class="mt-1 text-base leading-relaxed">{business.address}</dd>
          </div>
          <div class="py-4">
            <dt class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-haze"><span class="text-accent"><Icon name="clock" class="h-5 w-5" /></span>Jam operasional</dt>
            <dd class="mt-1 text-base leading-relaxed">{business.hours}</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={maps} class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
            Rute ke lokasi
            <Icon name="arrow" class="h-5 w-5" />
          </a>
          <a href="/kontak/" class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-paper/30 px-7 text-sm font-bold uppercase tracking-[0.1em] text-paper transition-colors hover:border-accent hover:text-accent active:scale-[0.98]">
            Kontak &amp; kunjungan
          </a>
        </div>
        <p class="mt-5 flex items-start gap-2 text-xs leading-relaxed text-haze">
          <span class="mt-0.5 text-accent"><Icon name="check" class="h-4 w-4" /></span>
          Nomor WhatsApp resmi belum terverifikasi, jadi CTA utama halaman ini adalah kunjungan langsung dan
          Google Maps &mdash; bukan tautan nomor yang belum pasti.
        </p>
      </div>

      <div class="md:col-span-7">
        <MapFacade src={business.mapsEmbed} title="Peta lokasi My Fitness The Hok Jambi" mapsUrl={maps} />
      </div>
    </div>
  </section>
</BaseLayout>
