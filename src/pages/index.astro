---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-7">
        <p class="flex items-center gap-2 text-sm font-medium text-sky-700">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">The Hok</span>
          <span class="text-zinc-500">• Gym warga • Kota Jambi</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">My Fitness — Gym Dekat Rumah di The Hok</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Gym area The Hok: latihan beban & kardio, kelas, personal training. Paling dekat buat warga sekitar — survei langsung, tanpa komitmen.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kontak" class="bg-sky-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Lihat Lokasi & Jam</a>
          <a href="/harga" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium hover:border-zinc-950 active:scale-[0.98]">Lihat Harga</a>
        </div>
        <div class="mt-8 flex divide-x divide-zinc-200 border-t border-zinc-200 pt-5 text-sm">
          <div class="pr-6"><p class="font-mono-num font-semibold">The Hok</p><p class="text-zinc-500">Area jangkauan</p></div>
          <div class="px-6"><p class="font-mono-num font-semibold">Beban+Kardio</p><p class="text-zinc-500">Fasilitas inti</p></div>
          <div class="pl-6"><p class="font-mono-num font-semibold">Langsung</p><p class="text-zinc-500">Survei lokasi</p></div>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="/images/my-fitness-1.jpg" alt="Area beban gym My Fitness The Hok Jambi" width="800" height="600" loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
          <div class="p-8">
            <p class="font-semibold text-lg tracking-tight">Dekat, jadi konsisten</p>
            <p class="mt-1 text-base text-gray-600">Jarak dekat = alasan malas berkurang. Mampir survei dulu sebelum member.</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-zinc-400">Sumber: Unsplash (foto konteks area beban, bebas lisensi) — ganti foto asli gym.</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <img src="/images/my-fitness-2.jpg" alt="Kelas grup kebugaran My Fitness Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        <div class="p-8">
          <p class="font-semibold text-lg tracking-tight">Program: gym, kelas & PT</p>
          <p class="text-base text-gray-600">Semua info program estimasi. <a class="underline" href="/program">Lihat program</a>.</p>
        </div>
      </div></div>
      <div class="md:col-span-5"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <img src="/images/my-fitness-3.jpg" alt="Sesi personal training My Fitness Jambi" width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
        <div class="p-8">
          <p class="font-semibold text-lg tracking-tight">Butuh dibimbing? Ada PT</p>
          <p class="text-base text-gray-600">Tanya trainer di lokasi. <a class="underline" href="/pelatih">Kenalan dengan pelatih</a>.</p>
        </div>
      </div></div>
    </div>
    <p class="mt-3 text-xs text-zinc-400">Sumber: Unsplash (foto konteks kelas & coaching, bebas lisensi) — ganti foto asli gym.</p>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="text-sm font-medium text-sky-700">Lokasi</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Mampir, lihat, baru putuskan</h2>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">{business.address}. <a class="underline text-zinc-900" href="/kontak">Info kunjungan</a> • <a class="underline text-zinc-900" href="/harga">Lihat harga</a></p>
      </div>
      <div class="md:col-span-7">
        <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title="Peta My Fitness Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
