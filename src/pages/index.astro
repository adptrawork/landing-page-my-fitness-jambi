---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs, prices } from '../data/business';
const voices = [
  { who: 'Warga The Hok', say: 'Dekat dari rumah — tidak ada alasan skip leg day lagi.' },
  { who: 'Member pagi', say: 'Datang sebentar sebelum kerja, sempat kardio 20 menit.' },
  { who: 'Pemula', say: 'Alatnya cukup untuk mulai. Dibantu trainer saat pertama datang.' },
  { who: 'Ibu rumah tangga', say: 'Sempat latihan selagi anak sekolah — pulangnya masih dekat.' },
  { who: 'Pekerja shift', say: 'Tinggal mampir sepulang dinas, tidak perlu lintas kota.' },
];
---
<BaseLayout title="My Fitness The Hok Jambi — Gym Dekat Rumah Warga" description="My Fitness area The Hok Jambi: gym beban & kardio, kelas, personal training untuk warga sekitar. Survei langsung ke lokasi — tanpa komitmen." canonicalPath="/" image={business.ogImage}>
  <!-- ASYMMETRIC WHITESPACE HERO -->
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="py-16 md:py-28 md:pr-[18vw]">
      <p class="drift font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">01 — The Hok, Kota Jambi</p>
      <h1 class="drift d1 mt-6 text-4xl md:text-6xl tracking-tighter leading-[1.02]">Gym yang dekat itu yang dipakai</h1>
      <p class="drift d2 mt-8 text-lg text-stone-500 leading-relaxed max-w-[55ch]">My Fitness di area The Hok: latihan beban &amp; kardio, kelas, personal training. Bukan yang paling mewah — tapi yang paling mungkin kamu datangi tiap minggu.</p>
      <div class="drift d3 mt-10 flex flex-wrap gap-4">
        <a href="/kontak" class="bg-lime-700 text-white px-8 py-4 rounded-full text-sm tracking-wide transition-all duration-300 hover:bg-lime-800 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Lihat Lokasi &amp; Jam</a>
        <a href="/harga" class="px-8 py-4 rounded-full text-sm tracking-wide underline underline-offset-8 decoration-lime-700/40 hover:decoration-lime-700">Lihat Harga</a>
      </div>
    </div>
    <div class="drift d4 grid grid-cols-1 md:grid-cols-12 gap-8 items-start pb-8">
      <figure class="md:col-span-7">
        <img src="/images/my-fitness-1.jpg" alt="Area beban gym My Fitness The Hok Jambi" width="1000" height="700" loading="eager" fetchpriority="high" class="w-full aspect-[10/7] object-cover rounded-[2.5rem]" />
        <figcaption class="mt-3 text-xs text-stone-400">Foto konteks area beban (Unsplash, bebas lisensi) — ganti foto asli gym.</figcaption>
      </figure>
      <div class="md:col-span-5 md:pt-16">
        <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-stone-400">Kenapa dekat menang</p>
        <ul class="mt-5 space-y-6 text-base text-stone-600">
          <li class="border-l-2 border-lime-700/60 pl-5">Jarak dekat <span class="text-stone-900">— alasan malas berkurang.</span></li>
          <li class="border-l-2 border-stone-200 pl-5">Survei dulu <span class="text-stone-900">— lihat alat &amp; suasana sebelum member.</span></li>
          <li class="border-l-2 border-stone-200 pl-5">Rutinitas warga <span class="text-stone-900">— selipkan 30–45 menit di harimu.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- GALLERY PROGRAM -->
  <section class="max-w-7xl mx-auto px-4 mt-32" aria-labelledby="program">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">02 — Program</p>
    <h2 id="program" class="mt-4 text-3xl md:text-4xl tracking-tighter leading-none">Seperlunya, selengkapnya</h2>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-12 gap-8">
      <figure class="md:col-span-8">
        <img src="/images/my-fitness-2.jpg" alt="Kelas grup kebugaran My Fitness Jambi" width="1000" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover rounded-[2.5rem]" />
        <figcaption class="mt-4 text-base text-stone-500">Kelas grup terjadwal. <a class="underline underline-offset-8 decoration-lime-700/40" href="/program">Semua program</a></figcaption>
      </figure>
      <figure class="md:col-span-4 md:mt-24">
        <img src="/images/my-fitness-3.jpg" alt="Sesi personal training My Fitness Jambi" width="600" height="700" loading="lazy" class="w-full aspect-[6/7] object-cover rounded-[2.5rem]" />
        <figcaption class="mt-4 text-base text-stone-500">Butuh dibimbing? Ada PT. <a class="underline underline-offset-8 decoration-lime-700/40" href="/pelatih">Kenalan pelatih</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- BENTO 70/30 HARGA + SHIMMER -->
  <section class="max-w-7xl mx-auto px-4 mt-32" aria-labelledby="harga">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">03 — Harga</p>
    <h2 id="harga" class="mt-4 text-3xl md:text-4xl tracking-tighter leading-none">Estimasi yang jujur</h2>
    <p class="mt-4 text-base text-stone-500 max-w-[55ch]">Belum ada price list resmi — konfirmasi di lokasi. <a class="underline underline-offset-8 decoration-lime-700/40" href="/harga">Rincian harga</a></p>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-10 gap-6">
      <div class="shimmer float-soft md:col-span-7 bg-white border border-stone-200/70 rounded-[2.5rem] p-10 md:p-14 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <p class="font-mono-num text-[11px] tracking-[0.25em] uppercase text-stone-400">{prices[3].badge}</p>
        <p class="mt-3 text-2xl md:text-3xl tracking-tight">{prices[3].name}</p>
        <p class="mt-3 font-mono-num text-4xl md:text-5xl text-lime-700">{prices[3].price}</p>
        <p class="mt-4 text-base text-stone-500">{prices[3].desc}</p>
      </div>
      <div class="md:col-span-3 flex flex-col gap-6">
        {prices.slice(1, 3).map((p) => (
          <div class="shimmer float-soft flex-1 bg-white border border-stone-200/70 rounded-[2.5rem] p-8">
            <p class="font-mono-num text-[11px] tracking-[0.25em] uppercase text-stone-400">{p.badge}</p>
            <p class="mt-2 tracking-tight">{p.name}</p>
            <p class="mt-2 font-mono-num text-xl text-lime-700">{p.price}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DRAG-TO-PAN TESTIMONI -->
  <section class="mt-32" aria-labelledby="suara">
    <div class="max-w-7xl mx-auto px-4">
      <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">04 — Suara warga</p>
      <h2 id="suara" class="mt-4 text-3xl md:text-4xl tracking-tighter leading-none">Geser untuk membaca</h2>
      <p class="mt-4 text-sm text-stone-400">Tarik / geser kartu ke samping — kesan warga sekitar (ilustrasi).</p>
    </div>
    <div class="pan no-scrollbar mt-10 flex gap-6 overflow-x-auto px-4 md:px-[max(1rem,calc((100vw-80rem)/2+1rem))] pb-4 select-none">
      {voices.map((v, i) => (
        <figure class={`drift d${(i % 6) + 1} shrink-0 w-[80vw] sm:w-[340px] rounded-[2.5rem] p-9 border active:scale-[0.98] ${i === 0 ? 'bg-lime-700 text-white border-lime-700' : 'bg-white border-stone-200/70'}`}>
          <blockquote class={`text-lg leading-relaxed tracking-tight ${i === 0 ? '' : 'text-stone-700'}`}>“{v.say}”</blockquote>
          <figcaption class={`mt-6 font-mono-num text-[11px] tracking-[0.25em] uppercase ${i === 0 ? 'text-lime-100' : 'text-stone-400'}`}>— {v.who}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- LOKASI -->
  <section class="max-w-7xl mx-auto px-4 mt-32" aria-labelledby="lokasi">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">05 — Lokasi</p>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-4">
        <h2 id="lokasi" class="text-3xl md:text-4xl tracking-tighter leading-none">Mampir, lihat, baru putuskan</h2>
        <p class="mt-4 text-base text-stone-500">{business.address}. <a class="underline underline-offset-8 decoration-lime-700/40" href="/kontak">Info kunjungan</a></p>
      </div>
      <div class="md:col-span-8">
        <div class="rounded-[2.5rem] overflow-hidden border border-stone-200/70 aspect-video bg-stone-100">
          <iframe title="Peta My Fitness Jambi" src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
