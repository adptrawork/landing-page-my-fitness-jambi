---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, programs } from '../data/business';
---
<BaseLayout title="Program My Fitness The Hok — Beban, Kelas & PT" description="Program My Fitness The Hok: open gym beban & kardio, kelas grup, personal training, asesmen pemula. Fasilitas pasti dikonfirmasi di lokasi." canonicalPath="/program">
  <section class="max-w-7xl mx-auto px-4 py-16 md:py-24 md:pr-[18vw]">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">Program</p>
    <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-[1.02]">Empat pintu masuk yang sama</h1>
    <p class="mt-6 text-lg text-stone-500 max-w-[55ch]">Semua info <strong>Estimasi</strong> — fasilitas pasti cek lokasi.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-12 gap-8">
    {programs.map((p, i) => (
      <figure class={i === 0 ? 'md:col-span-7' : i === 1 ? 'md:col-span-5 md:mt-20' : i === 2 ? 'md:col-span-5' : 'md:col-span-7 md:-mt-20'}>
        <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" class="w-full aspect-[16/10] object-cover rounded-[2.5rem]" />
        <figcaption class="mt-4">
          <p class="font-mono-num text-[11px] tracking-[0.25em] uppercase text-lime-700">{p.badge}</p>
          <p class="mt-1 text-xl tracking-tight">{p.name}</p>
          <p class="mt-1 text-base text-stone-500">{p.desc}</p>
        </figcaption>
      </figure>
    ))}
  </section>
  <p class="max-w-7xl mx-auto px-4 mt-10 text-xs text-stone-400">Sumber foto: Unsplash (bebas lisensi) — ganti foto asli gym.</p>
</BaseLayout>
