---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business, programs } from '../data/business';
const maps = business.mapsUrl;
---
<!-- Ref: athletic editorial index — daftar program ber-nomor dengan rule, kontras tinggi -->
<BaseLayout
  title="Program, Kelas & Personal Training My Fitness Jambi"
  description="Rincian program My Fitness Jambi: open gym beban dan kardio, kelas grup, personal training, serta asesmen pemula. Survey dulu ke lokasi, tanpa komitmen."
  canonicalPath="/program/"
  crumb="Program"
  image={business.ogImage}
>
  <section class="border-b border-paper/10" aria-labelledby="page-title">
    <div class="mx-auto max-w-7xl px-4 py-14 md:py-20">
      <nav class="text-[11px] font-semibold uppercase tracking-[0.2em] text-haze" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-accent">Beranda</a>
        <span class="px-2 text-paper/30">/</span>
        <span class="text-paper">Program</span>
      </nav>
      <h1 id="page-title" class="font-display mt-5 max-w-[20ch] text-4xl font-bold uppercase leading-[0.94] tracking-tight md:text-6xl">
        Program &amp; kelas
      </h1>
      <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-haze md:text-lg">
        Empat jalur latihan yang tersedia di My Fitness kawasan The Hok. Karena jadwal resmi belum kami
        terima, setiap program hanya menandai tingkat keyakinan datanya &mdash; bukan jam pasti.
      </p>
      <a href={maps} class="mt-8 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
        Rute ke lokasi
        <Icon name="arrow" class="h-5 w-5" />
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 md:py-20" aria-label="Daftar program">
    <ol class="divide-y divide-paper/10 border-y border-paper/10">
      {programs.map((p, i) => (
        <li class="grid grid-cols-1 gap-6 py-8 md:grid-cols-12 md:items-center md:gap-8">
          <div class="md:col-span-1">
            <span class="num font-display text-4xl font-bold leading-none text-accent md:text-5xl">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="md:col-span-6">
            <span class="inline-block rounded-full border border-paper/20 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-haze">{p.badge}</span>
            <h2 class="font-display mt-3 text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">{p.name}</h2>
            <p class="mt-3 max-w-[54ch] text-base leading-relaxed text-haze">{p.desc}</p>
          </div>
          <div class="md:col-span-5">
            <div class="relative overflow-hidden rounded-2xl border border-paper/10">
              <img src={p.img} alt={p.alt} width="800" height="600" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-12">
      <p class="text-xs leading-relaxed text-haze md:col-span-7">
        Foto bersifat konteks, bukan dokumentasi resmi My Fitness Jambi. Label "Estimasi" menandakan informasi
        yang perlu dikonfirmasi di lokasi sebelum dijadikan acuan.
      </p>
      <a href="/harga/" class="text-sm font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent md:col-span-5 md:text-right">
        Lihat estimasi harga keanggotaan
      </a>
    </div>
  </section>

  <section class="border-t border-paper/10 bg-ink-2/25" aria-label="Ajakan kunjungan">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between md:py-16">
      <div>
        <p class="font-display text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">Butuh bantuan memilih?</p>
        <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-haze">
          Tanyakan langsung di lokasi &mdash; petugas dapat menyesuaikan program dengan level dan tujuanmu.
        </p>
      </div>
      <a href={maps} class="inline-flex w-max min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
        Buka Google Maps
        <Icon name="arrow" class="h-5 w-5" />
      </a>
    </div>
  </section>
</BaseLayout>
