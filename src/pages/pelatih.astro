---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { business, coaches } from '../data/business';
const maps = business.mapsUrl;
---
<!-- Ref: athletic coach directory — visual aksi/non-wajah + credential teks, tanpa klaim identitas -->
<BaseLayout
  title="Coach, Instruktur & Personal Trainer My Fitness Jambi"
  description="Peran coach My Fitness Jambi: pendamping teknik dasar, instruktur kelas terjadwal, dan personal trainer. Nama serta sertifikasi dikonfirmasi langsung di lokasi."
  canonicalPath="/pelatih/"
  crumb="Pelatih"
  image={business.ogImage}
>
  <section class="border-b border-paper/10" aria-labelledby="page-title">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 py-14 md:grid-cols-12 md:py-20">
      <div class="md:col-span-7">
        <nav class="text-[11px] font-semibold uppercase tracking-[0.2em] text-haze" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-accent">Beranda</a>
          <span class="px-2 text-paper/30">/</span>
          <span class="text-paper">Pelatih</span>
        </nav>
        <h1 id="page-title" class="font-display mt-5 max-w-[18ch] text-4xl font-bold uppercase leading-[0.94] tracking-tight md:text-6xl">
          Didampingi, bukan dilepas
        </h1>
        <p class="mt-5 max-w-[60ch] text-base leading-relaxed text-haze md:text-lg">
          Tiga peran pendamping tersedia di lokasi. Kami sengaja tidak menampilkan nama, wajah, atau sertifikasi
          pelatih karena data itu belum terverifikasi &mdash; bukan karena tidak ada.
        </p>
        <a href={maps} class="mt-8 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
          Rute ke lokasi
          <Icon name="arrow" class="h-5 w-5" />
        </a>
      </div>
      <div class="md:col-span-5">
        <div class="relative overflow-hidden rounded-2xl border border-paper/10">
          <img
            src="/images/my-fitness-3.webp"
            alt="Rak dumbel di area latihan beban My Fitness Jambi"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <p class="mt-3 text-xs leading-relaxed text-haze">Visual konteks area latihan &mdash; bukan foto identitas pelatih.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 md:py-20" aria-labelledby="peran-title">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">Peran</p>
        <h2 id="peran-title" class="font-display mt-2 text-4xl font-bold uppercase leading-[0.95] tracking-tight md:text-5xl">
          Siapa yang mendampingi
        </h2>
      </div>
      <p class="text-sm leading-relaxed text-haze md:col-span-4">
        Peran berikut mengikuti data yang kami miliki. Tarif, jadwal, dan ketersediaan dikonfirmasi di lokasi.
      </p>
    </div>

    <ol class="mt-10 divide-y divide-paper/10 border-y border-paper/10">
      {coaches.map((c, i) => (
        <li class="grid grid-cols-1 gap-4 py-7 md:grid-cols-12 md:items-center md:gap-8">
          <div class="flex items-center gap-4 md:col-span-5">
            <span class="num font-display text-3xl font-bold leading-none text-accent md:text-4xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide md:text-3xl">{c.role}</h3>
          </div>
          <p class="text-sm leading-relaxed text-haze md:col-span-5">{c.desc}</p>
          <div class="md:col-span-2 md:text-right">
            <span class="inline-block rounded-full border border-paper/20 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-haze">{c.badge}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-t border-paper/10 bg-ink-2/25" aria-label="Ajakan kunjungan">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between md:py-16">
      <div>
        <p class="font-display text-3xl font-bold uppercase leading-none tracking-tight md:text-4xl">Mau mulai dari nol?</p>
        <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-haze">
          Sampaikan tujuanmu saat berkunjung supaya pendamping bisa menyarankan langkah pertama yang aman.
        </p>
      </div>
      <a href={maps} class="inline-flex w-max min-h-[48px] items-center gap-2 rounded-full bg-accent px-7 text-sm font-bold uppercase tracking-[0.1em] text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98]">
        Buka Google Maps
        <Icon name="arrow" class="h-5 w-5" />
      </a>
    </div>
  </section>
</BaseLayout>
