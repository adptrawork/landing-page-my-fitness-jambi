---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, coaches } from '../data/business';
---
<BaseLayout title="Pelatih My Fitness The Hok — Coach & Instruktur" description="Tim My Fitness The Hok: coach gym, instruktur kelas, personal trainer. Nama coach aktual tanya langsung di lokasi." canonicalPath="/pelatih">
  <section class="max-w-7xl mx-auto px-4 py-16 md:py-24 md:pr-[18vw]">
    <p class="font-mono-num text-[11px] tracking-[0.3em] uppercase text-lime-700">Pelatih</p>
    <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-[1.02]">Wajah yang kamu temui tiap sore</h1>
    <p class="mt-6 text-lg text-stone-500 max-w-[55ch]">Peran <strong>Estimasi</strong> — nama coach aktual tanya di lokasi.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 space-y-16">
    {coaches.map((c, i) => (
      <div class={`grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline border-t border-stone-200/80 pt-10 ${i % 2 === 1 ? 'md:text-right' : ''}`}>
        <p class={`font-mono-num text-sm text-lime-700 md:col-span-2 ${i % 2 === 1 ? 'md:order-3' : ''}`}>0{i + 1} / {c.badge}</p>
        <h2 class={`text-2xl md:text-3xl tracking-tight md:col-span-6 ${i % 2 === 1 ? 'md:order-2' : ''}`}>{c.role}</h2>
        <p class={`text-base text-stone-500 md:col-span-4 ${i % 2 === 1 ? 'md:order-1' : ''}`}>{c.desc}</p>
      </div>
    ))}
  </section>
  <section class="max-w-7xl mx-auto px-4 mt-24 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <figure class="md:col-span-5">
      <img src="/images/my-fitness-3.jpg" alt="Sesi personal training My Fitness Jambi" width="600" height="600" loading="lazy" class="w-full aspect-square object-cover rounded-[2.5rem]" />
    </figure>
    <div class="md:col-span-7">
      <p class="text-xl tracking-tight">Datang, sapa, minta dibimbing di sesi pertama.</p>
      <a href="/kontak" class="mt-6 inline-block bg-lime-700 text-white px-8 py-4 rounded-full text-sm active:scale-[0.98]">Info Kunjungan</a>
    </div>
  </section>
</BaseLayout>
